[
  {
    "id": 1,
    "title": "暮春归故山草堂",
    "dynasty": "唐",
    "author": "钱起",
    "lines": [
      "谷口春残黄鸟稀，辛夷花尽杏花飞。",
      "始怜幽竹山窗下，不改清阴待我归。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%9A%AE%E6%98%A5%E6%AD%B8%E6%95%85%E5%B1%B1%E8%8D%89%E5%A0%82"
  },
  {
    "id": 2,
    "title": "城西访友人别墅",
    "dynasty": "唐",
    "author": "雍陶",
    "lines": [
      "澧水桥西小路斜，日高犹未到君家。",
      "村园门巷多相似，处处春风枳壳花。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%85%A8%E5%94%90%E8%A9%A9%2F%E5%8D%B7518"
  },
  {
    "id": 3,
    "title": "临平道中",
    "dynasty": "宋",
    "author": "道潜",
    "lines": [
      "风蒲猎猎弄轻柔，欲立蜻蜓不自由。",
      "五月临平山下路，藕花无数满汀洲。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%AC%BD%E5%AE%9A%E5%8F%A4%E4%BB%8A%E5%9C%96%E6%9B%B8%E9%9B%86%E6%88%90%2F%E5%8D%9A%E7%89%A9%E5%BD%99%E7%B7%A8%2F%E8%8D%89%E6%9C%A8%E5%85%B8%2F%E7%AC%AC098%E5%8D%B7"
  },
  {
    "id": 4,
    "title": "江中对月",
    "dynasty": "唐",
    "author": "刘长卿",
    "lines": [
      "空洲夕烟敛，望月秋江里。",
      "历历沙上人，月中孤渡水。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%B1%9F%E4%B8%AD%E5%B0%8D%E6%9C%88"
  },
  {
    "id": 5,
    "title": "绝句漫兴（其七）",
    "dynasty": "唐",
    "author": "杜甫",
    "lines": [
      "糁径杨花铺白毡，点溪荷叶叠青钱。",
      "笋根稚子无人见，沙上凫雏傍母眠。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%BC%AB%E8%88%88_%28%E6%9D%9C%E7%94%AB%29"
  },
  {
    "id": 6,
    "title": "立秋",
    "dynasty": "宋",
    "author": "刘翰",
    "lines": [
      "乳鸦啼散玉屏空，一枕新凉一扇风。",
      "睡起秋声无觅处，满阶梧叶月明中。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E7%AB%8B%E7%A7%8B"
  },
  {
    "id": 7,
    "title": "送柴侍御",
    "dynasty": "唐",
    "author": "王昌龄",
    "lines": [
      "流水通波接武冈，送君不觉有离伤。",
      "青山一道同云雨，明月何曾是两乡。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E9%80%81%E6%9F%B4%E4%BE%8D%E5%BE%A1"
  },
  {
    "id": 8,
    "title": "江南曲（其三）",
    "dynasty": "唐",
    "author": "储光羲",
    "lines": [
      "日暮长江里，相邀归渡头。",
      "落花如有意，来去逐船流。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%AC%BD%E5%AE%9A%E5%8F%A4%E4%BB%8A%E5%9C%96%E6%9B%B8%E9%9B%86%E6%88%90%2F%E6%98%8E%E5%80%AB%E5%BD%99%E7%B7%A8%2F%E9%96%A8%E5%AA%9B%E5%85%B8%2F%E7%AC%AC009%E5%8D%B7"
  },
  {
    "id": 9,
    "title": "庆全庵桃花",
    "dynasty": "宋",
    "author": "谢枋得",
    "lines": [
      "寻得桃源好避秦，桃红又是一年春。",
      "花飞莫遣随流水，怕有渔郎来问津。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%85%B6%E5%85%A8%E5%BA%B5%E6%A1%83%E8%8A%B1"
  },
  {
    "id": 10,
    "title": "休暇日访王侍御不遇",
    "dynasty": "唐",
    "author": "韦应物",
    "lines": [
      "九日驱驰一日闲，寻君不遇又空还。",
      "怪来诗思清人骨，门对寒流雪满山。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E4%BC%91%E6%9A%87%E6%97%A5%E8%A8%AA%E7%8E%8B%E4%BE%8D%E5%BE%A1%E4%B8%8D%E9%81%87"
  },
  {
    "id": 11,
    "title": "雪中偶题",
    "dynasty": "唐",
    "author": "郑谷",
    "lines": [
      "乱飘僧舍茶烟湿，密洒歌楼酒力微。",
      "江上晚来堪画处，渔人披得一蓑归。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E9%9B%AA%E4%B8%AD%E5%81%B6%E9%A1%8C"
  },
  {
    "id": 12,
    "title": "赠范晔",
    "dynasty": "南北朝",
    "author": "陆凯",
    "lines": [
      "折花逢驿使，寄与陇头人。",
      "江南无所有，聊赠一枝春。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%A4%AA%E5%B9%B3%E5%BE%A1%E8%A6%BD_%28%E5%9B%9B%E9%83%A8%E5%8F%A2%E5%88%8A%E6%9C%AC%29%2F%E5%8D%B7%E4%B9%8B%E4%B9%9D%E7%99%BE%E4%B8%83%E5%8D%81"
  },
  {
    "id": 13,
    "title": "书李世南所画秋景",
    "dynasty": "宋",
    "author": "苏轼",
    "lines": [
      "野水参差落涨痕，疏林欹倒出霜根。",
      "扁舟一棹归何处，家在江南黄叶村。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%9B%B8%E6%9D%8E%E4%B8%96%E5%8D%97%E6%89%80%E7%95%AB%E7%A7%8B%E6%99%AF"
  },
  {
    "id": 14,
    "title": "剑门道中遇微雨",
    "dynasty": "宋",
    "author": "陆游",
    "lines": [
      "衣上征尘杂酒痕，远游无处不销魂。",
      "此身合是诗人未？细雨骑驴入剑门。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%8A%8D%E9%96%80%E9%81%93%E4%B8%AD%E9%81%87%E5%BE%AE%E9%9B%A8"
  },
  {
    "id": 15,
    "title": "霜月",
    "dynasty": "唐",
    "author": "李商隐",
    "lines": [
      "初闻征雁已无蝉，百尺楼高水接天。",
      "青女素娥俱耐冷，月中霜里斗婵娟。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%8D%83%E5%AE%B6%E8%A9%A9%2F%E5%8D%B7%E4%B8%89"
  },
  {
    "id": 16,
    "title": "栾家濑",
    "dynasty": "唐",
    "author": "王维",
    "lines": [
      "飒飒秋雨中，浅浅石溜泻。",
      "跳波自相溅，白鹭惊复下。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E8%BC%9E%E5%B7%9D%E9%9B%86_%28%E7%8E%8B%E7%B6%AD%29"
  },
  {
    "id": 17,
    "title": "泗州东城晚望",
    "dynasty": "宋",
    "author": "秦观",
    "lines": [
      "渺渺孤城白水环，舳舻人语夕霏间。",
      "林梢一抹青如画，应是淮流转处山。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%B3%97%E5%B7%9E%E4%B8%9C%E5%9F%8E%E6%99%9A%E6%9C%9B"
  },
  {
    "id": 18,
    "title": "夏意",
    "dynasty": "宋",
    "author": "苏舜钦",
    "lines": [
      "别院深深夏簟清，石榴开遍透帘明。",
      "树阴满地日当午，梦觉流莺时一声。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%AC%BD%E5%AE%9A%E5%8F%A4%E4%BB%8A%E5%9C%96%E6%9B%B8%E9%9B%86%E6%88%90%2F%E6%9B%86%E8%B1%A1%E5%BD%99%E7%B7%A8%2F%E6%AD%B2%E5%8A%9F%E5%85%B8%2F%E7%AC%AC043%E5%8D%B7"
  },
  {
    "id": 19,
    "title": "盆池（其一）",
    "dynasty": "唐",
    "author": "韩愈",
    "lines": [
      "老翁真个似童儿，汲水埋盆作小池。",
      "一夜青蛙鸣到晓，恰如方口钓鱼时。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E7%9B%86%E6%B1%A0%E4%BA%94%E9%A6%96"
  },
  {
    "id": 20,
    "title": "戏题",
    "dynasty": "唐",
    "author": "孟浩然",
    "lines": [
      "客醉眠未起，主人呼解酲。",
      "已言鸡黍熟，复道瓮头清。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%88%B2%E9%A1%8C_%28%E5%AD%9F%E6%B5%A9%E7%84%B6%29"
  },
  {
    "id": 21,
    "title": "雨中登岳阳楼望君山",
    "dynasty": "宋",
    "author": "黄庭坚",
    "lines": [
      "满川风雨独凭栏，绾结湘娥十二鬟。",
      "可惜不当湖水面，银山堆里看青山。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E8%B1%AB%E7%AB%A0%E9%BB%83%E5%85%88%E7%94%9F%E6%96%87%E9%9B%86_%28%E5%9B%9B%E9%83%A8%E5%8F%A2%E5%88%8A%E6%9C%AC%29%2F%E5%8D%B7%E7%AC%AC%E5%8D%81%E4%B8%80"
  },
  {
    "id": 22,
    "title": "秋日",
    "dynasty": "宋",
    "author": "秦观",
    "lines": [
      "霜落邗沟积水清，寒星无数傍船明。",
      "菰蒲深处疑无地，忽有人家笑语声。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E8%A9%A9%E6%9E%97%E5%BB%A3%E8%A8%98_%28%E5%9B%9B%E5%BA%AB%E5%85%A8%E6%9B%B8%E6%9C%AC%29%2F%E5%BE%8C%E9%9B%86%E5%8D%B708"
  },
  {
    "id": 23,
    "title": "鹭鸶",
    "dynasty": "唐",
    "author": "杜牧",
    "lines": [
      "雪衣雪发青玉觜，群捕鱼儿溪影中。",
      "惊飞远映碧山去，一树梨花落晚风。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%85%A8%E5%94%90%E8%A9%A9%2F%E5%8D%B7522"
  },
  {
    "id": 24,
    "title": "咏露珠",
    "dynasty": "唐",
    "author": "韦应物",
    "lines": [
      "秋荷一滴露，清夜坠玄天。",
      "将来玉盘上，不定始知圆。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E8%A9%A0%E9%9C%B2%E7%8F%A0"
  },
  {
    "id": 25,
    "title": "新凉",
    "dynasty": "宋",
    "author": "徐玑",
    "lines": [
      "水满田畴稻叶齐，日光穿树晓烟低。",
      "黄莺也爱新凉好，飞过青山影里啼。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%96%B0%E6%B6%BC_%28%E5%BE%90%E7%92%A3%29"
  },
  {
    "id": 26,
    "title": "汉江",
    "dynasty": "唐",
    "author": "杜牧",
    "lines": [
      "溶溶漾漾白鸥飞，绿净春深好染衣。",
      "南去北来人自老，夕阳长送钓船归。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%85%A8%E5%94%90%E8%A9%A9%2F%E5%8D%B7523"
  },
  {
    "id": 27,
    "title": "送郭司仓",
    "dynasty": "唐",
    "author": "王昌龄",
    "lines": [
      "映门淮水绿，留骑主人心。",
      "明月随良掾，春潮夜夜深。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%94%90%E8%A9%A9%E5%93%81%E5%BD%9A_%28%E5%9B%9B%E5%BA%AB%E5%85%A8%E6%9B%B8%E6%9C%AC%29%2F%E5%8D%B740"
  },
  {
    "id": 28,
    "title": "东坡",
    "dynasty": "宋",
    "author": "苏轼",
    "lines": [
      "雨洗东坡月色清，市人行尽野人行。",
      "莫嫌荦确坡头路，自爱铿然曳杖声。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%9D%B1%E5%9D%A1"
  },
  {
    "id": 29,
    "title": "渡浙江问舟中人",
    "dynasty": "唐",
    "author": "孟浩然",
    "lines": [
      "潮落江平未有风，扁舟共济与君同。",
      "时时引领望天末，何处青山是越中。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%B8%A1%E6%B5%99%E6%B1%9F%E5%95%8F%E8%88%9F%E4%B8%AD%E4%BA%BA"
  },
  {
    "id": 30,
    "title": "晚春田园杂兴",
    "dynasty": "宋",
    "author": "范成大",
    "lines": [
      "蝴蝶双双入菜花，日长无客到田家。",
      "鸡飞过篱犬吠窦，知有行商来买茶。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%99%9A%E6%98%A5%E7%94%B0%E5%9C%92%E9%9B%9C%E8%88%88"
  },
  {
    "id": 31,
    "title": "牧竖",
    "dynasty": "唐",
    "author": "崔道融",
    "lines": [
      "牧竖持蓑笠，逢人气傲然。",
      "卧牛吹短笛，耕却傍溪田。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%85%A8%E5%94%90%E8%A9%A9%2F%E5%8D%B7714"
  },
  {
    "id": 32,
    "title": "三日寻李九庄",
    "dynasty": "唐",
    "author": "常建",
    "lines": [
      "雨歇杨林东渡头，永和三日荡轻舟。",
      "故人家在桃花岸，直到门前溪水流。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E4%B8%89%E6%97%A5%E5%B0%8B%E6%9D%8E%E4%B9%9D%E8%8E%8A"
  },
  {
    "id": 33,
    "title": "水口行舟",
    "dynasty": "宋",
    "author": "朱熹",
    "lines": [
      "昨夜扁舟雨一蓑，满江风浪夜如何。",
      "今朝试卷孤篷看，依旧青山绿树多。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%99%A6%E5%BA%B5%E5%85%88%E7%94%9F%E6%9C%B1%E6%96%87%E5%85%AC%E6%96%87%E9%9B%86_%28%E5%9B%9B%E9%83%A8%E5%8F%A2%E5%88%8A%E6%9C%AC%29%2F%E5%8D%B7%E7%AC%AC%E5%8D%81"
  },
  {
    "id": 34,
    "title": "梦中作",
    "dynasty": "宋",
    "author": "欧阳修",
    "lines": [
      "夜凉吹笛千山月，路暗迷人百种花。",
      "棋罢不知人换世，酒阑无奈客思家。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%A4%A2%E4%B8%AD%E4%BD%9C_%28%E6%AD%90%E9%99%BD%E4%BF%AE%29"
  },
  {
    "id": 35,
    "title": "送崔九",
    "dynasty": "唐",
    "author": "裴迪",
    "lines": [
      "归山深浅去，须尽丘壑美。",
      "莫学武陵人，暂游桃源里。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%B4%94%E4%B9%9D%E6%AC%B2%E5%BE%80%E5%8D%97%E5%B1%B1%E9%A6%AC%E4%B8%8A%E5%8F%A3%E8%99%9F%E8%88%87%E5%88%A5"
  },
  {
    "id": 36,
    "title": "襄邑道中",
    "dynasty": "宋",
    "author": "陈与义",
    "lines": [
      "飞花两岸照舡红，百里榆堤半日风。",
      "卧看满天云不动，不知云与我俱东。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E7%B0%A1%E9%BD%8B%E8%A9%A9%E9%9B%86%2F4"
  },
  {
    "id": 37,
    "title": "齐安郡后池绝句",
    "dynasty": "唐",
    "author": "杜牧",
    "lines": [
      "菱透浮萍绿锦池，夏莺千啭弄蔷薇。",
      "尽日无人看微雨，鸳鸯相对浴红衣。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E9%BD%8A%E5%AE%89%E9%83%A1%E5%BE%8C%E6%B1%A0%E7%B5%95%E5%8F%A5"
  },
  {
    "id": 38,
    "title": "丰乐亭游春（其三）",
    "dynasty": "宋",
    "author": "欧阳修",
    "lines": [
      "红树青山日欲斜，长郊草色绿无涯。",
      "游人不管春将老，来往亭前踏落花。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%AD%90%E9%99%BD%E4%BF%AE%E9%9B%86%2F%E5%8D%B7011"
  },
  {
    "id": 39,
    "title": "秋浦歌（其十三）",
    "dynasty": "唐",
    "author": "李白",
    "lines": [
      "渌水净素月，月明白鹭飞。",
      "郎听采菱女，一道夜歌归。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E7%A7%8B%E6%B5%A6%E6%AD%8C"
  },
  {
    "id": 40,
    "title": "莺梭",
    "dynasty": "宋",
    "author": "刘克庄",
    "lines": [
      "掷柳迁乔太有情，交交时作弄机声。",
      "洛阳三月花如锦，多少工夫织得成。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E9%B6%AF%E6%A2%AD"
  },
  {
    "id": 41,
    "title": "江上",
    "dynasty": "宋",
    "author": "王安石",
    "lines": [
      "江北秋阴一半开，晚云含雨却低回。",
      "青山缭绕疑无路，忽见千帆隐映来。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E7%8E%8B%E8%87%A8%E5%B7%9D%E9%9B%86%2F%E5%8D%B7030"
  },
  {
    "id": 42,
    "title": "观游鱼",
    "dynasty": "唐",
    "author": "白居易",
    "lines": [
      "绕池闲步看鱼游，正值儿童弄钓舟。",
      "一种爱鱼心各异，我来施食尔垂钩。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E8%A7%80%E9%81%8A%E9%AD%9A"
  },
  {
    "id": 43,
    "title": "独酌",
    "dynasty": "唐",
    "author": "杜牧",
    "lines": [
      "窗外正风雪，拥炉开酒缸。",
      "何如钓船雨，篷底睡秋江。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%85%A8%E5%94%90%E8%A9%A9%2F%E5%8D%B7521"
  },
  {
    "id": 44,
    "title": "北山",
    "dynasty": "宋",
    "author": "王安石",
    "lines": [
      "北山输绿涨横池，直堑回塘滟滟时。",
      "细数落花因坐久，缓寻芳草得归迟。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%8C%97%E5%B1%B1_%28%E7%8E%8B%E5%AE%89%E7%9F%B3%29"
  },
  {
    "id": 45,
    "title": "山行留客",
    "dynasty": "唐",
    "author": "张旭",
    "lines": [
      "山光物态弄春辉，莫为轻阴便拟归。",
      "纵使晴明无雨色，入云深处亦沾衣。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%B1%B1%E8%A1%8C%E7%95%99%E5%AE%A2"
  },
  {
    "id": 46,
    "title": "初见嵩山",
    "dynasty": "宋",
    "author": "张耒",
    "lines": [
      "年来鞍马困尘埃，赖有青山豁我怀。",
      "日暮北风吹雨去，数峰清瘦出云来。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%88%9D%E8%A6%8B%E5%B5%A9%E5%B1%B1"
  },
  {
    "id": 47,
    "title": "山泉煎茶有怀",
    "dynasty": "唐",
    "author": "白居易",
    "lines": [
      "坐酌泠泠水，看煎瑟瑟尘。",
      "无由持一碗，寄与爱茶人。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E7%99%BD%E6%B0%8F%E9%95%B7%E6%85%B6%E9%9B%86%2F%E5%8D%B7020"
  },
  {
    "id": 48,
    "title": "巴女谣",
    "dynasty": "唐",
    "author": "于鹄",
    "lines": [
      "巴女骑牛唱竹枝，藕丝菱叶傍江时。",
      "不愁日暮还家错，记得芭蕉出槿篱。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%B7%B4%E5%A5%B3%E8%AC%A0"
  },
  {
    "id": 49,
    "title": "早行",
    "dynasty": "宋",
    "author": "陈与义",
    "lines": [
      "露侵驼褐晓寒轻，星斗阑干分外明。",
      "寂寞小桥和梦过，稻田深处草虫鸣。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E7%B0%A1%E9%BD%8B%E8%A9%A9%E9%9B%86%2F%E5%A4%96%E9%9B%86"
  },
  {
    "id": 50,
    "title": "小长干曲",
    "dynasty": "唐",
    "author": "崔国辅",
    "lines": [
      "月暗送潮风，相寻路不通。",
      "菱歌唱不彻，知在此塘中。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%BE%A1%E5%AE%9A%E5%85%A8%E5%94%90%E8%A9%A9_%28%E5%9B%9B%E5%BA%AB%E5%85%A8%E6%9B%B8%E6%9C%AC%29%2F%E5%8D%B7119"
  },
  {
    "id": 51,
    "title": "游洞庭（其二）",
    "dynasty": "唐",
    "author": "李白",
    "lines": [
      "南湖秋水夜无烟，耐可乘流直上天。",
      "且就洞庭赊月色，将船买酒白云边。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%85%A8%E5%94%90%E8%A9%A9%2F%E5%8D%B7179"
  },
  {
    "id": 52,
    "title": "春日",
    "dynasty": "宋",
    "author": "秦观",
    "lines": [
      "一夕轻雷落万丝，霁光浮瓦碧参差。",
      "有情芍药含春泪，无力蔷薇卧晓枝。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%98%A5%E6%97%A5_%28%E7%A7%A6%E8%A7%80%29"
  },
  {
    "id": 53,
    "title": "漫成一绝",
    "dynasty": "唐",
    "author": "杜甫",
    "lines": [
      "江月去人只数尺，风灯照夜欲三更。",
      "沙头宿鹭联拳静，船尾跳鱼拨剌鸣。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%85%A8%E5%94%90%E8%A9%A9%2F%E5%8D%B7229"
  },
  {
    "id": 54,
    "title": "书事",
    "dynasty": "唐",
    "author": "王维",
    "lines": [
      "轻阴阁小雨，深院昼慵开。",
      "坐看苍苔色，欲上人衣来。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%9B%B8%E4%BA%8B"
  },
  {
    "id": 55,
    "title": "小雨",
    "dynasty": "宋",
    "author": "杨万里",
    "lines": [
      "雨来细细复疏疏，纵不能多不肯无。",
      "似妒诗人山入眼，千峰故隔一帘珠。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%BE%A1%E5%AE%9A%E4%BD%A9%E6%96%87%E9%BD%8B%E8%A9%A0%E7%89%A9%E8%A9%A9%E9%81%B8_%28%E5%9B%9B%E5%BA%AB%E5%85%A8%E6%9B%B8%E6%9C%AC%29%2F%E5%8D%B7010"
  },
  {
    "id": 56,
    "title": "成都曲",
    "dynasty": "唐",
    "author": "张籍",
    "lines": [
      "锦江近西烟水绿，新雨山头荔枝熟。",
      "万里桥边多酒家，游人爱向谁家宿。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%88%90%E9%83%BD%E6%9B%B2"
  },
  {
    "id": 57,
    "title": "湖上寓居杂咏",
    "dynasty": "宋",
    "author": "姜夔",
    "lines": [
      "荷叶披披一浦凉，青芦奕奕夜吟商。",
      "平生最识江湖味，听得秋声忆故乡。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%B1%9F%E6%B9%96%E5%B0%8F%E9%9B%86_%28%E5%9B%9B%E5%BA%AB%E5%85%A8%E6%9B%B8%E6%9C%AC%29%2F%E5%8D%B756"
  },
  {
    "id": 58,
    "title": "拜新月",
    "dynasty": "唐",
    "author": "李端",
    "lines": [
      "开帘见新月，便即下阶拜。",
      "细语人不闻，北风吹裙带。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%8B%9C%E6%96%B0%E6%9C%88"
  },
  {
    "id": 59,
    "title": "和袭美春夕酒醒",
    "dynasty": "唐",
    "author": "陆龟蒙",
    "lines": [
      "几年无事傍江湖，醉倒黄公旧酒垆。",
      "觉后不知明月上，满身花影倩人扶。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%85%A8%E5%94%90%E8%A9%A9%2F%E5%8D%B7628"
  },
  {
    "id": 60,
    "title": "暮热游荷池上",
    "dynasty": "宋",
    "author": "杨万里",
    "lines": [
      "细草摇头忽报侬，披襟拦得一西风。",
      "荷花入暮犹愁热，低面深藏碧伞中。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%AE%8B%E8%A9%A9%E9%88%94_%28%E5%9B%9B%E5%BA%AB%E5%85%A8%E6%9B%B8%E6%9C%AC%29%2F%E5%8D%B7072"
  },
  {
    "id": 61,
    "title": "送沈子福归江东",
    "dynasty": "唐",
    "author": "王维",
    "lines": [
      "杨柳渡头行客稀，罟师荡桨向临圻。",
      "惟有相思似春色，江南江北送君归。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E9%80%81%E6%B2%88%E5%AD%90%E7%A6%8F%E6%AD%B8%E6%B1%9F%E6%9D%B1"
  },
  {
    "id": 62,
    "title": "衔鱼翠鸟",
    "dynasty": "唐",
    "author": "钱起",
    "lines": [
      "有意莲叶间，瞥然下高树。",
      "擘波得潜鱼，一点翠光去。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E8%97%8D%E7%94%B0%E6%BA%AA%E9%9B%9C%E8%A9%A0"
  },
  {
    "id": 63,
    "title": "梅",
    "dynasty": "宋",
    "author": "王淇",
    "lines": [
      "不受尘埃半点侵，竹篱茅舍自甘心。",
      "只因误识林和靖，惹得诗人说到今。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%A2%85_%28%E7%8E%8B%E6%B7%87%29"
  },
  {
    "id": 64,
    "title": "井栏砂宿遇夜客",
    "dynasty": "唐",
    "author": "李涉",
    "lines": [
      "暮雨萧萧江上村，绿林豪客夜知闻。",
      "他时不用逃名姓，世上如今半是君。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E4%BA%95%E6%AC%84%E7%A0%82%E5%AE%BF%E9%81%87%E5%A4%9C%E5%AE%A2"
  },
  {
    "id": 65,
    "title": "洛桥晚望",
    "dynasty": "唐",
    "author": "孟郊",
    "lines": [
      "天津桥下冰初结，洛阳陌上人行绝。",
      "榆柳萧疏楼阁闲，月明直见嵩山雪。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%B4%9B%E6%A9%8B%E6%99%9A%E6%9C%9B"
  },
  {
    "id": 66,
    "title": "人日思归",
    "dynasty": "隋",
    "author": "薛道衡",
    "lines": [
      "入春才七日，离家已二年。",
      "人归落雁后，思发在花前。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E4%BA%BA%E6%97%A5%E6%80%9D%E6%AD%B8"
  },
  {
    "id": 67,
    "title": "秋词（其二）",
    "dynasty": "唐",
    "author": "刘禹锡",
    "lines": [
      "山明水净夜来霜，数树深红出浅黄。",
      "试上高楼清入骨，岂如春色嗾人狂。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E7%A7%8B%E8%A9%9E%E4%BA%8C%E9%A6%96"
  },
  {
    "id": 68,
    "title": "别滁",
    "dynasty": "宋",
    "author": "欧阳修",
    "lines": [
      "花光浓烂柳轻明，酌酒花前送我行。",
      "我亦且如常日醉，莫教弦管作离声。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%AD%90%E9%99%BD%E4%BF%AE%E9%9B%86%2F%E5%8D%B7011"
  },
  {
    "id": 69,
    "title": "戏题盘石",
    "dynasty": "唐",
    "author": "王维",
    "lines": [
      "可怜盘石临泉水，复有垂杨拂酒杯。",
      "若道春风不解意，何因吹送落花来。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%88%B2%E9%A1%8C%E7%9B%A4%E7%9F%B3"
  },
  {
    "id": 70,
    "title": "自遣",
    "dynasty": "唐",
    "author": "李白",
    "lines": [
      "对酒不觉暝，落花盈我衣。",
      "醉起步溪月，鸟还人亦稀。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E8%87%AA%E9%81%A3_%28%E6%9D%8E%E7%99%BD%29"
  },
  {
    "id": 71,
    "title": "过垂虹",
    "dynasty": "宋",
    "author": "姜夔",
    "lines": [
      "自作新词韵最娇，小红低唱我吹箫。",
      "曲终过尽松陵路，回首烟波十四桥。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E7%99%BD%E7%9F%B3%E9%81%93%E4%BA%BA%E8%A9%A9%E9%9B%86_%28%E5%9B%9B%E9%83%A8%E5%8F%A2%E5%88%8A%E6%9C%AC%29%2F%E5%8D%B7%E4%B8%8B"
  },
  {
    "id": 72,
    "title": "兰溪棹歌",
    "dynasty": "唐",
    "author": "戴叔伦",
    "lines": [
      "凉月如眉挂柳湾，越中山色镜中看。",
      "兰溪三日桃花雨，半夜鲤鱼来上滩。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E8%98%AD%E6%BA%AA%E6%A3%B9%E6%AD%8C"
  },
  {
    "id": 73,
    "title": "江村即事",
    "dynasty": "唐",
    "author": "司空曙",
    "lines": [
      "钓罢归来不系船，江村月落正堪眠。",
      "纵然一夜风吹去，只在芦花浅水边。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%B1%9F%E6%9D%91%E5%8D%B3%E4%BA%8B"
  },
  {
    "id": 74,
    "title": "题齐安壁",
    "dynasty": "宋",
    "author": "王安石",
    "lines": [
      "日净山如染，风暄草欲薰。",
      "梅残数点雪，麦涨一溪云。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E7%8E%8B%E8%87%A8%E5%B7%9D%E9%9B%86%2F%E5%8D%B7026"
  },
  {
    "id": 75,
    "title": "南堂（其五）",
    "dynasty": "宋",
    "author": "苏轼",
    "lines": [
      "扫地焚香闭阁眠，簟纹如水帐如烟。",
      "客来梦觉知何处，挂起西窗浪接天。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%8D%97%E5%A0%82%E4%BA%94%E9%A6%96"
  },
  {
    "id": 76,
    "title": "雨过山村",
    "dynasty": "唐",
    "author": "王建",
    "lines": [
      "雨里鸡鸣一两家，竹溪村路板桥斜。",
      "妇姑相唤浴蚕去，闲着中庭栀子花。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E8%90%AC%E9%A6%96%E5%94%90%E4%BA%BA%E7%B5%B6%E5%8F%A5_%28%E5%9B%9B%E5%BA%AB%E5%85%A8%E6%9B%B8%E6%9C%AC%29%2F%E4%B8%83%E8%A8%80%E5%8D%B730"
  },
  {
    "id": 77,
    "title": "幼女词",
    "dynasty": "唐",
    "author": "施肩吾",
    "lines": [
      "幼女才六岁，未知巧与拙。",
      "向夜在堂前，学人拜新月。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%94%90%E8%A9%A9%E5%93%81%E5%BD%9A_%28%E5%9B%9B%E5%BA%AB%E5%85%A8%E6%9B%B8%E6%9C%AC%29%2F%E5%8D%B743"
  },
  {
    "id": 78,
    "title": "秋凉晚步",
    "dynasty": "宋",
    "author": "杨万里",
    "lines": [
      "秋气堪悲未必然，轻寒政是可人天。",
      "绿池落尽红蕖却，荷叶犹开最小钱。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E8%AA%A0%E9%BD%8B%E9%9B%86_%28%E5%9B%9B%E9%83%A8%E5%8F%A2%E5%88%8A%E6%9C%AC%29%2F%E5%8D%B7%E7%AC%AC%E5%85%AB"
  },
  {
    "id": 79,
    "title": "横塘",
    "dynasty": "宋",
    "author": "范成大",
    "lines": [
      "南浦春来绿一川，石桥朱塔两依然。",
      "年年送客横塘路，细雨垂杨系画船。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E7%9F%B3%E6%B9%96%E5%B1%85%E5%A3%AB%E8%A9%A9%E9%9B%86_%28%E5%9B%9B%E9%83%A8%E5%8F%A2%E5%88%8A%E6%9C%AC%29%2F%E5%8D%B7%E7%AC%AC%E4%B8%89"
  },
  {
    "id": 80,
    "title": "夏昼偶作",
    "dynasty": "唐",
    "author": "柳宗元",
    "lines": [
      "南州溽暑醉如酒，隐几熟眠开北牖。",
      "日午独觉无余声，山童隔竹敲茶臼。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%AC%BD%E5%AE%9A%E5%8F%A4%E4%BB%8A%E5%9C%96%E6%9B%B8%E9%9B%86%E6%88%90%2F%E6%9B%86%E8%B1%A1%E5%BD%99%E7%B7%A8%2F%E6%AD%B2%E5%8A%9F%E5%85%B8%2F%E7%AC%AC043%E5%8D%B7"
  },
  {
    "id": 81,
    "title": "秋夜喜遇王处士",
    "dynasty": "唐",
    "author": "王绩",
    "lines": [
      "北场芸藿罢，东皋刈黍归。",
      "相逢秋月满，更值夜萤飞。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E7%A7%8B%E5%A4%9C%E5%96%9C%E9%81%87%E7%8E%8B%E8%99%95%E5%A3%AB"
  },
  {
    "id": 82,
    "title": "白梅",
    "dynasty": "元",
    "author": "王冕",
    "lines": [
      "冰雪林中著此身，不同桃李混芳尘。",
      "忽然一夜清香发，散作乾坤万里春。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E7%9F%B3%E5%80%89%E5%8E%AF%E4%BB%A3%E8%A9%A9%E9%81%B8_%28%E5%9B%9B%E5%BA%AB%E5%85%A8%E6%9B%B8%E6%9C%AC%29%2F%E5%8D%B7278"
  },
  {
    "id": 83,
    "title": "野望",
    "dynasty": "宋",
    "author": "翁卷",
    "lines": [
      "一天秋色冷晴湾，无数峰峦远近间。",
      "闲上山来看野水，忽于水底见青山。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E9%87%8E%E6%9C%9B_%28%E7%BF%81%E5%8D%B7%29"
  },
  {
    "id": 84,
    "title": "望湖楼醉书（其二）",
    "dynasty": "宋",
    "author": "苏轼",
    "lines": [
      "放生鱼鳖逐人来，无主荷花到处开。",
      "水枕能令山俯仰，风船解与月徘徊。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%85%AD%E6%9C%88%E4%BA%8C%E5%8D%81%E4%B8%83%E6%97%A5%E6%9C%9B%E6%B9%96%E6%A8%93%E9%86%89%E6%9B%B8%E4%BA%94%E7%B5%B6"
  },
  {
    "id": 85,
    "title": "碧涧驿晓思",
    "dynasty": "唐",
    "author": "温庭筠",
    "lines": [
      "香灯伴残梦，楚国在天涯。",
      "月落子规歇，满庭山杏花。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E7%A2%A7%E6%BE%97%E9%A9%9B%E6%9B%89%E6%80%9D"
  },
  {
    "id": 86,
    "title": "花下醉",
    "dynasty": "唐",
    "author": "李商隐",
    "lines": [
      "寻芳不觉醉流霞，倚树沉眠日已斜。",
      "客散酒醒深夜后，更持红烛赏残花。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E8%8A%B1%E4%B8%8B%E9%86%89"
  },
  {
    "id": 87,
    "title": "夜直",
    "dynasty": "宋",
    "author": "王安石",
    "lines": [
      "金炉香尽漏声残，翦翦轻风阵阵寒。",
      "春色恼人眠不得，月移花影上栏干。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E8%87%A8%E5%B7%9D%E5%85%88%E7%94%9F%E6%96%87%E9%9B%86_%28%E5%9B%9B%E9%83%A8%E5%8F%A2%E5%88%8A%E6%9C%AC%29%2F%E5%8D%B7%E7%AC%AC%E4%B8%89%E5%8D%81%E4%B8%80"
  },
  {
    "id": 88,
    "title": "社日",
    "dynasty": "唐",
    "author": "王驾",
    "lines": [
      "鹅湖山下稻粱肥，豚栅鸡栖半掩扉。",
      "桑柘影斜春社散，家家扶得醉人归。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E7%A4%BE%E6%97%A5"
  },
  {
    "id": 89,
    "title": "秋夜寄丘二十二员外",
    "dynasty": "唐",
    "author": "韦应物",
    "lines": [
      "怀君属秋夜，散步咏凉天。",
      "山空松子落，幽人应未眠。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E7%A7%8B%E5%A4%9C%E5%AF%84%E4%B8%98%E4%BA%8C%E5%8D%81%E4%BA%8C%E5%93%A1%E5%A4%96"
  },
  {
    "id": 90,
    "title": "城南",
    "dynasty": "宋",
    "author": "曾巩",
    "lines": [
      "雨过横塘水满堤，乱山高下路东西。",
      "一番桃李花开尽，惟有青青草色齐。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%9F%8E%E5%8D%97%E4%BA%8C%E9%A6%96"
  },
  {
    "id": 91,
    "title": "苏溪亭",
    "dynasty": "唐",
    "author": "戴叔伦",
    "lines": [
      "苏溪亭上草漫漫，谁倚东风十二阑。",
      "燕子不归春事晚，一汀烟雨杏花寒。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E8%98%87%E6%BA%AA%E4%BA%AD"
  },
  {
    "id": 92,
    "title": "过郑山人所居",
    "dynasty": "唐",
    "author": "刘长卿",
    "lines": [
      "寂寂孤莺啼杏园，寥寥一犬吠桃源。",
      "落花芳草无寻处，万壑千峰独闭门。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E9%81%8E%E9%84%AD%E5%B1%B1%E4%BA%BA%E6%89%80%E5%B1%85"
  },
  {
    "id": 93,
    "title": "南浦",
    "dynasty": "宋",
    "author": "王安石",
    "lines": [
      "南浦随花去，回舟路已迷。",
      "暗香无觅处，日落画桥西。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%8D%97%E6%B5%A6_%28%E7%8E%8B%E5%AE%89%E7%9F%B3%29"
  },
  {
    "id": 94,
    "title": "题金陵渡",
    "dynasty": "唐",
    "author": "张祜",
    "lines": [
      "金陵津渡小山楼，一宿行人自可愁。",
      "潮落夜江斜月里，两三星火是瓜洲。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E9%A1%8C%E9%87%91%E9%99%B5%E6%B8%A1"
  },
  {
    "id": 95,
    "title": "钟山即事",
    "dynasty": "宋",
    "author": "王安石",
    "lines": [
      "涧水无声绕竹流，竹西花草弄春柔。",
      "茅檐相对坐终日，一鸟不鸣山更幽。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E9%90%98%E5%B1%B1%E5%8D%B3%E4%BA%8B"
  },
  {
    "id": 96,
    "title": "溪兴",
    "dynasty": "唐",
    "author": "杜荀鹤",
    "lines": [
      "山雨溪风卷钓丝，瓦瓯蓬底独斟时。",
      "醉来睡着无人唤，流下前溪也不知。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%BC%81%E9%9A%A0%E5%8F%A2%E8%A9%B1_%28%E5%9B%9B%E5%BA%AB%E5%85%A8%E6%9B%B8%E6%9C%AC%29%2F%E5%BE%8C%E9%9B%86%E5%8D%B715"
  },
  {
    "id": 97,
    "title": "白石滩",
    "dynasty": "唐",
    "author": "王维",
    "lines": [
      "清浅白石滩，绿蒲向堪把。",
      "家住水东西，浣纱明月下。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E8%BC%9E%E5%B7%9D%E9%9B%86_%28%E7%8E%8B%E7%B6%AD%29"
  },
  {
    "id": 98,
    "title": "四时田园杂兴",
    "dynasty": "宋",
    "author": "范成大",
    "lines": [
      "新筑场泥镜面平，家家打稻趁霜晴。",
      "笑歌声里轻雷动，一夜连枷响到明。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E5%9B%9B%E6%99%82%E7%94%B0%E5%9C%92%E9%9B%9C%E8%88%88"
  },
  {
    "id": 99,
    "title": "淮中晚泊犊头",
    "dynasty": "宋",
    "author": "苏舜钦",
    "lines": [
      "春阴垂野草青青，时有幽花一树明。",
      "晚泊孤舟古祠下，满川风雨看潮生。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E6%B7%AE%E4%B8%AD%E6%99%9A%E6%B3%8A%E7%8A%A2%E9%A0%AD"
  },
  {
    "id": 100,
    "title": "芦花",
    "dynasty": "唐",
    "author": "雍裕之",
    "lines": [
      "夹岸复连沙，枝枝摇浪花。",
      "月明浑似雪，无处认渔家。"
    ],
    "source": "https://zh.wikisource.org/wiki/%E8%98%86%E8%8A%B1"
  }
]
